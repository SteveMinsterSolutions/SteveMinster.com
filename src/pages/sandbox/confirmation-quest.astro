---
// src/pages/sandbox/confirmation-quest.astro
// Confirmation Quest: a private, invite-only game. Its own document shell and look
// (an illuminated book, not SM branding); tokens.css ships on this page only.
import App from '../../components/ConfirmationQuest/App.tsx';
import '../../components/ConfirmationQuest/tokens.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="A private game for Confirmation candidates and their sponsors." />
    <meta name="theme-color" content="#F4ECD8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1E1A14" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/sandbox/confirmation-quest/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/sandbox/confirmation-quest/icon.svg" />
    <link rel="apple-touch-icon" href="/sandbox/confirmation-quest/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Quest" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <title>Confirmation Quest</title>
  </head>
  <body class="cq">
    <App client:load />
  </body>
</html>
