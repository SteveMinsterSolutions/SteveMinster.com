---
// Shared document shell for the Warriors wrestling pages (scorer + follow).
// Unlisted: always noindex,nofollow; never linked from the site nav or sitemap.
// Team colors only (royal + gold); no logos or helmet artwork.
interface Props { title: string }
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#0A1A3F" />
    <meta name="referrer" content="same-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Barlow+Semi+Condensed:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="wr">
    <slot />
  </body>
</html>
