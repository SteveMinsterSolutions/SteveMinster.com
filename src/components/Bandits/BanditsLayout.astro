---
// Shared document shell for the Bandits pages (info, sign-up, coach).
// Bandits' own look, not SM branding: Oswald + Source Sans 3, black/gold tokens.
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Page ground: white for the info page, sand for the sign-up page. */
  ground?: 'white' | 'sand';
}

const { title, description = 'Wilson County Bandits 13U tackle football, Fall 2026.', noindex = false, ground = 'white' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class={`bandits ground-${ground}`}>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --b-black: #111111;
    --b-gold: #D4A72C;      /* fills, and gold text on black only */
    --b-gold-ink: #6B5300;  /* gold-ish text and links on white (passes 4.5:1) */
    --b-white: #FFFFFF;
    --b-sand: #F4F1E6;
    --b-cream: #FBF6E4;
    --b-text-2: #444444;
    --b-border: #8A8A8A;
    --b-display: Oswald, Impact, sans-serif;
    --b-body: 'Source Sans 3', system-ui, sans-serif;
  }
  body.bandits {
    margin: 0;
    font-family: var(--b-body);
    color: var(--b-black);
    font-size: 1.0625rem;
    line-height: 1.55;
    overflow-wrap: break-word;
  }
  body.ground-white { background: var(--b-white); }
  body.ground-sand { background: var(--b-sand); }
  .bandits a { color: var(--b-gold-ink); }
  .bandits a:hover { color: var(--b-black); }
  /* Focus ring: black on light grounds; gold inside dark surfaces, which opt in
     with class="on-dark" (header, hero, dark cards, footer). */
  .bandits :focus-visible {
    outline: 3px solid var(--b-black);
    outline-offset: 2px;
  }
  .bandits .on-dark:focus-visible,
  .bandits .on-dark :focus-visible {
    outline-color: var(--b-gold);
  }
  .bandits .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  @media (max-width: 400px) {
    .bandits .wrap { padding-left: 1.25rem; padding-right: 1.25rem; }
  }
</style>
